YOUTUBE_CLIENT_ID=your_client_id_here
YOUTUBE_CLIENT_SECRET=your_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:8080
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Path to OAuth2 token file (auto-generated after first login)
TOKEN_FILE=token.json

# Path to OAuth2 credentials file (downloaded from Google Cloud Console)
CREDENTIALS_FILE=credentials.json

# Default video privacy: public, unlisted, private
DEFAULT_PRIVACY=private

# Schedule storage file
SCHEDULE_FILE=schedule.json
